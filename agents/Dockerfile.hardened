# ==============================================================================
# ETAPA 1: Builder (Compilación e instalación limpia de dependencias)
# ==============================================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# ETAPA 2: Runtime Endurecido (Sin compiladores, sin shell, usuario no-root)
# ==============================================================================
FROM python:3.12-slim-bookworm AS runtime

RUN groupadd -r agentgroup && \
    useradd -r -g agentgroup -d /tmp -s /usr/sbin/nologin agentuser

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

COPY --chown=root:agentgroup --chmod=0550 *.py /app/
COPY --chown=root:agentgroup --chmod=0440 quarantine_grammar.gbnf /app/

RUN chmod 0555 /app

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    HF_HOME=/tmp/huggingface \
    TORCH_HOME=/tmp/torch \
    TRANSFORMERS_CACHE=/tmp/huggingface/transformers

USER agentuser

CMD ["python", "-u", "moltbook_crawler.py"]
